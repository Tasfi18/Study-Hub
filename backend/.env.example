# Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://your-production-frontend-url.vercel.app
EMAIL_REDIRECT_URL=https://your-production-frontend-url.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=104857600  # 100MB to support video uploads

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage Configuration
STORAGE_PROVIDER=supabase  # Options: 'supabase', 'cloudflare-r2', or 'local'

# Cloudflare R2 Configuration (only needed if STORAGE_PROVIDER=cloudflare-r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=study-materials
R2_PUBLIC_URL=https://pub-your_hash_here.r2.dev
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here